# Copy to .env and fill in. NEVER commit .env.
# Hugging Face read token (needs access granted at https://huggingface.co/facebook/sam3)
HF_TOKEN=

# Label Studio admin (created on first start of the container)
LS_USER_EMAIL=admin@example.com
LS_PASSWORD=admin12345

# Legacy API token for the admin user (40 hex chars). Used by the ML backend to download
# uploaded images and by scripts/*.py. Pre-seeded in the container via LABEL_STUDIO_USER_TOKEN.
LABEL_STUDIO_API_KEY=0123456789abcdef0123456789abcdef01234567

# Where the ML backend (running on the host) reaches Label Studio
LABEL_STUDIO_URL=http://localhost:8080

# Backend settings
ML_BACKEND_PORT=9090
SAM3_MODEL_ID=facebook/sam3
PYTORCH_ENABLE_MPS_FALLBACK=1
